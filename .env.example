# Lidas no build (site estático): mudou, gere o build de novo.

# Domínio oficial, sem barra no fim (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://vispecapital.com

# Supabase (Project Settings → API). Chave publicável: segura no navegador,
# o acesso é limitado pelas policies de RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL do App da Web do Apps Script (termina em /exec) que grava os formulários
# na planilha — ver integrations/google-sheets/Code.gs. Sem ela, os formulários
# mostram "envio sendo configurado" com as redes da Vispe.
NEXT_PUBLIC_FORMS_ENDPOINT=https://script.google.com/macros/s/<id>/exec
