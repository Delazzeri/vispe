# Lidas no build (site estático): mudou, gere o build de novo.

# Domínio oficial, sem barra no fim (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://vispecapital.com

# Supabase (Project Settings → API). Chave publicável: segura no navegador,
# o acesso é limitado pelas policies de RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL do App da Web do Apps Script (termina em /exec) que grava os formulários
# na planilha — ver integrations/google-sheets/Code.gs. Sem ela, os formulários
# mostram "envio sendo configurado" com as redes da Vispe.
NEXT_PUBLIC_FORMS_ENDPOINT=https://script.google.com/macros/s/<id>/exec

# ── Anúncios e remarketing (docs/marketing-tracking.md) ──────────────────────
# Só carregam depois que a pessoa aceita os cookies de marketing (ou de análise,
# no GA4). Vazio = plataforma desligada.

# Meta (Facebook/Instagram): Gerenciador de Eventos → Fontes de dados → Pixel → ID.
NEXT_PUBLIC_META_PIXEL_ID=
# Opcional: conteúdo da meta tag de verificação do domínio (Business Manager →
# Segurança da marca → Domínios). Pode usar o registro DNS no lugar.
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=

# LinkedIn: Campaign Manager → Analisar → Insight Tag → Partner ID.
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
# IDs das conversões (Analisar → Rastreamento de conversões → tipo "evento específico").
NEXT_PUBLIC_LINKEDIN_CONVERSION_LEAD=
NEXT_PUBLIC_LINKEDIN_CONVERSION_REGISTRATION=
NEXT_PUBLIC_LINKEDIN_CONVERSION_CONTACT=

# Google Ads (pronto, desligado até preencher): ID AW-… e o rótulo de cada conversão
# (Metas → Conversões → a conversão → Configurar tag → trecho depois da barra em AW-…/rótulo).
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_LEAD=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_REGISTRATION=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_CONTACT=
# Google Analytics 4 (G-…), opcional: carrega com o consentimento de análise.
NEXT_PUBLIC_GA4_ID=

# ── Estatísticas de visita (Umami Cloud) ─────────────────────────────────────
# Contagem anônima e sem cookies, para todos os visitantes (não depende do banner).
# Os números aparecem em /admin/metricas/ (ver supabase/README.md, seção Métricas).
# Umami Cloud → Websites → o site → Edit → Website ID. Vazio = desligado.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Link de compartilhamento do painel (Websites → o site → Edit → Share URL): o admin mostra
# o painel do Umami por ele enquanto não há a API (plano gratuito).
NEXT_PUBLIC_UMAMI_SHARE_URL=
# Opcional: domínios em que as visitas contam (padrão: o de NEXT_PUBLIC_SITE_URL, com e sem www).
NEXT_PUBLIC_UMAMI_DOMAINS=
